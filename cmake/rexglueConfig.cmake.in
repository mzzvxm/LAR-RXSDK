@PACKAGE_INIT@

set(REXGLUE_VERSION_STRING "@REXGLUE_FULL_VERSION@")

set(REXGLUE_SHARE_DIR "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_DATADIR@/rexglue")
set(REXGLUE_MOLTENVK_ICD
    "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_DATADIR@/vulkan/icd.d/MoltenVK_icd.json")

include(CMakeFindDependencyMacro)

include("${CMAKE_CURRENT_LIST_DIR}/rexglue_helpers.cmake")

list(PREPEND CMAKE_PREFIX_PATH "${PACKAGE_PREFIX_DIR}")

find_dependency(fmt CONFIG)
find_dependency(spdlog CONFIG)
find_dependency(utf8cpp CONFIG)
find_dependency(SDL3 CONFIG)

set(REXGLUE_USE_D3D12 @REXGLUE_USE_D3D12@)
set(REXGLUE_USE_VULKAN @REXGLUE_USE_VULKAN@)

# A project that needs graphics backends built into this SDK names them in
# REXGLUE_REQUIRED_GRAPHICS_BACKENDS (for example "d3d12;vulkan") before it finds
# the SDK, and gets the fix here instead of a missing backend at run time.
# CHECK: written from how LARecomp's CMakeLists.txt sets the variable; not compared with any other
# SDK build's handling of it.
foreach(_rexglue_required_backend IN LISTS REXGLUE_REQUIRED_GRAPHICS_BACKENDS)
    string(TOUPPER "${_rexglue_required_backend}" _rexglue_required_option)
    if(NOT REXGLUE_USE_${_rexglue_required_option})
        message(FATAL_ERROR
            "This ReXGlue SDK was built without the ${_rexglue_required_backend} graphics "
            "backend, which the project requires (REXGLUE_REQUIRED_GRAPHICS_BACKENDS). "
            "Rebuild the SDK with -DREXGLUE_USE_${_rexglue_required_option}=ON.")
    endif()
endforeach()

if(REXGLUE_USE_VULKAN)
    find_dependency(VulkanHeaders CONFIG)
    find_dependency(VulkanMemoryAllocator CONFIG)
    if(APPLE)
        if(NOT TARGET rex::vulkan-loader)
            add_library(rex::vulkan-loader SHARED IMPORTED)
            set_target_properties(rex::vulkan-loader PROPERTIES
                IMPORTED_LOCATION "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_LIBDIR@/libvulkan.1.dylib")
        endif()

        if(NOT TARGET rex::moltenvk)
            add_library(rex::moltenvk SHARED IMPORTED)
            set_target_properties(rex::moltenvk PROPERTIES
                IMPORTED_LOCATION "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_LIBDIR@/libMoltenVK.dylib")
        endif()
    endif()
endif()

include("${CMAKE_CURRENT_LIST_DIR}/rexglueTargets.cmake")

# Only Release rexglue is installed, so every consumer config has to reach it.
if(TARGET rex::rexglue)
    set_target_properties(rex::rexglue PROPERTIES
        MAP_IMPORTED_CONFIG_DEBUG Release
        MAP_IMPORTED_CONFIG_RELWITHDEBINFO Release
        MAP_IMPORTED_CONFIG_MINSIZEREL Release)
endif()

if(TARGET rex::runtime AND NOT TARGET rex::system)
    add_library(rex::system ALIAS rex::runtime)
endif()
if(TARGET rex::runtime AND NOT TARGET rex::kernel)
    add_library(rex::kernel ALIAS rex::runtime)
endif()

if(NOT rexglue_FIND_QUIETLY)
    message(STATUS "Found ReXGlue SDK ${REXGLUE_VERSION_STRING} at (${PACKAGE_PREFIX_DIR})")
endif()

check_required_components(rexglue)
